{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "show",
    "markdown": "rendered",
    "grouping": "auto",
    "new_location": "launch",
    "permissions": "prompt"
  },
  "animations": true,
  "tabs": {
    "mode": "on"
  },
  "debug": {
    "devtools": false
  }
}
